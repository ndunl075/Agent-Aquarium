{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "jsx": "react-jsx", "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@aquarium/protocol": ["./packages/protocol/src/index.ts"],
      "@aquarium/domain": ["./packages/domain/src/index.ts"],
      "@aquarium/adapters": ["./packages/adapters/src/index.ts"],
      "@aquarium/cli": ["./packages/cli/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", ".worktrees", "**/dist/**"]
}
